
@{
    ViewBag.Title = "Create";
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<h2>Create Section</h2>
<form method="post">

    <label>Course Name</label><input type="text" name="course_name" value="" /><br />
    <label>Course Credit</label><input type="text" name="course_credit" value="" /> <br />

    <button type="submit" class="btn btn-primary">Create Section</button>
</form>

